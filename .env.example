# ==============================================================================
# CẤU HÌNH BOT TÀI CHÍNH & TÌNH BÁO X (ASSISSTAN BOT)
# ==============================================================================

# Telegram Bot Token (Lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Google Gemini API Key (Lấy từ Google AI Studio)
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-3.8-flash

# Cổng dịch vụ X Intel Service (Mặc định: 8890)
X_INTEL_URL=http://127.0.0.1:8890

# Múi giờ hệ thống (Mặc định: Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh
